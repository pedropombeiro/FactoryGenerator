<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
	<metadata>
		<id>DeveloperInTheFlow.FactoryGenerator</id>
		<version>3.9.4</version>
		<title>Factory Generator (Roslyn)</title>
		<authors>Pedro Pombeiro,Daniel Romero,Benjamin Burgy</authors>
		<owners>Pedro Pombeiro</owners>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<developmentDependency>true</developmentDependency>
		<description>
			Console application that automatically generates factory implementations for classes marked with [GenerateFactory] attribute, by using Roslyn C# Compiler-as-a-Service. New files named &lt;TargetClass&gt;Factory.Generated.cs are added to the project.

			Can be used in a build server environment.
		</description>
		<releaseNotes>Support latest msbuild and use newer version of newtonsoft.json</releaseNotes>
		<copyright>Copyright © Pedro Pombeiro 2015</copyright>
		<tags>factories Roslyn C#</tags>
	</metadata>
	<files>
		<file src="..\bin\Release\net48\DefaultTemplate.render" target="tools\DefaultTemplate.render" />
		<file src="..\bin\Release\net48\FactoryGenerator.exe" target="tools\FactoryGenerator.exe" />
		<file src="..\bin\Release\net48\FactoryGenerator.exe.config" target="tools\FactoryGenerator.exe.config" />
		<file src="..\bin\Release\net48\BuildHost-net472\**" target="tools\BuildHost-net472\" />
		<file src="..\bin\Release\net48\BuildHost-netcore\**" target="tools\BuildHost-netcore\" />
		<file src="..\bin\Release\net48\*.dll" target="tools\" />
		<file src="tools\init.ps1" target="tools\init.ps1" />
		<file src="ThirdPartyNotices.rtf" target="ThirdPartyNotices.rtf" />
	</files>
</package>